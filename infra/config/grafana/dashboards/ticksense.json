    {
      "id": 14,
      "type": "timeseries",
      "title": "Order Book Imbalance",
      "description": "Positive = buy pressure, negative = sell pressure. Range: -1 to +1.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "options": {
