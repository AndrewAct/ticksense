      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "min": -1,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "market_bid_ask_imbalance",
          "legendFormat": "{{symbol}}",
          "refId": "A"
