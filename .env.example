# ============================================================
# TickSense local configuration
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ── Kafka / Redpanda ─────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── Binance (public data — no API key required) ──────────────
# Global (non-US):
# BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
# BINANCE_REST_BASE_URL=https://api.binance.com
# US (HTTP 451 from US IPs on global endpoint):
BINANCE_WS_BASE_URL=wss://stream.binance.us:9443/ws
BINANCE_REST_BASE_URL=https://api.binance.us

# Symbols to ingest (JSON array format required by pydantic-settings v2)
INGEST_SYMBOLS=["btcusdt","ethusdt","solusdt","bnbusdt","xrpusdt"]

# ── MinIO / Object storage (local) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ticksense
S3_REGION=us-east-1

# ── Iceberg ──────────────────────────────────────────────────
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_CATALOG_NAME=local

# ── Postgres (OLTP source for CDC) ───────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticksense
POSTGRES_USER=ticksense
POSTGRES_PASSWORD=changeme

# ── Trino ────────────────────────────────────────────────────
TRINO_HOST=localhost
TRINO_PORT=8082
TRINO_CATALOG=iceberg
TRINO_SCHEMA=normalized
TRINO_USER=ticksense

# ── App ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=local
